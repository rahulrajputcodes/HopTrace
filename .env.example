# HopTrace Environment Variables Reference
# Copy this template to .env and configure real values.
# NEVER commit .env to git. Names only in this template.

# --- Application & Network Mode ---
APP_VERSION=
DATA_MODE=

# --- Authentication & RBAC (M2) ---
AUTH_DISABLED=
AUTH_SECRET=
OPERATOR_PASSWORD=
VIEWER_PASSWORD=
EVALUATOR_PASSWORD=
INGEST_API_KEY=

# --- CORS & Origins ---
CORS_ORIGINS=

# --- Database & Persistence ---
SQLITE_DB_PATH=
SEED_DEMO_SUBSCRIBERS=
SEED_DEMO_INCIDENTS=
RUNS_RETENTION_LIMIT=

# --- Topology & Engine (M1) ---
TOPOLOGY_PROVIDER=
DEPENDENCY_ADAPTER=

# --- AI & Explanations (Sarvam) ---
EXPLANATION_PROVIDER=
SARVAM_API_KEY=
SARVAM_MODEL=
SARVAM_TIMEOUT_SECONDS=

# --- Graph Engine (Neo4j) (M1) ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Telemetry Freshness & Timing ---
LIVE_TTL_SECONDS=
AGENT_SILENT_SECONDS=

# --- Business Impact & SLA Credits ---
SLA_CREDIT_RATE_PER_HOUR=

# --- Notifications & Dispatch (M3) ---
NOTIFICATION_PROVIDER=
REAL_SEND_ALLOWLIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
